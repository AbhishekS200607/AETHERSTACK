# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
# SERVICE ROLE key — used ONLY by the backend, NEVER expose to browser
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# ── Email (Gmail App Password) ───────────────────────────────
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password

# ── JWT ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-hex-string

# ── Admin ────────────────────────────────────────────────────
ADMIN_SECRET=replace-with-a-strong-random-secret

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://aetherstack.in,https://www.aetherstack.in

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
